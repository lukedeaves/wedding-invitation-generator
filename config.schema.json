{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Wedding invitation configuration",
  "type": "object",
  "required": ["wedding", "guests"],
  "properties": {
    "wedding": {
      "type": "object",
      "required": ["bride_name", "groom_name", "date", "time", "venue"],
      "properties": {
        "bride_name": { "type": "string", "minLength": 1 },
        "groom_name": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "minLength": 1 },
        "time": { "type": "string", "minLength": 1 },
        "reception_note": { "type": "string" },
        "venue": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "address_1": { "type": "string" },
            "address_2": { "type": "string" },
            "postcode": { "type": "string" }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "directory": { "type": "string" }
      }
    },
    "guests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["guest_names"],
        "properties": {
          "guest_names": { "type": "string", "minLength": 1 }
        }
      }
    },
    "guests_file": {
      "type": "string",
      "description": "Optional CSV file with a guest_names column"
    }
  }
}
